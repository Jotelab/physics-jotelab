# Judge / evaluation profile
#
# Copy to `.env.local` for any run where what is on screen will be taken as
# evidence of what the software does — a judging session, a recorded demo, a
# screenshot in the report.
#
# The rule this file encodes: **every number a viewer sees must come from the
# symbolic engine.** The switches that break that rule are listed at the bottom
# and must all stay unset. `instrumentation.ts` prints a warning at server
# start if any of them are on, and `next.config.ts` refuses a production build
# outright.
#
#   cp .env.judge.example .env.local   # then fill in the blanks below
#
# How to test this profile is really engine-backed:
#   curl -s $ENGINE_BASE_URL/health          # lists the engine's topics
#   npm run dev                              # must print NO "demo mode" warning
#   open /learn                              # a Thai SUVAT problem, not the error box
#   npx vitest run lib/demo-mode.test.ts     # the guard rails themselves

# --- Required: the symbolic engine ------------------------------------------
# Start it from the jotelab-ai repo:
#   ENGINE_API_KEY=dev-secret uvicorn service.app:app --port 8000
ENGINE_BASE_URL=http://127.0.0.1:8000
ENGINE_API_KEY=dev-secret

# --- Required: Supabase (auth, worksheet persistence, credits) ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_JWT_SECRET=

# --- Required for worksheet generation: the phrasing model -------------------
# The engine computes; this model only phrases the Thai prose.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Required for background generation --------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- The invariant -----------------------------------------------------------
GENERATION_MODE=neuro_symbolic

# --- Must stay UNSET for an evaluation run -----------------------------------
# Each of these makes the app show content that is not engine-generated. They
# are listed here deliberately, so the omission is visible rather than assumed.
#
#   E2E_STUB_GENERATION  fixed stub question; no engine call, no model call
#   DEV_PASSWORD_LOGIN   dev-only password form on /login
#   GENERATION_MODE=llm_only   the model computes the numbers
