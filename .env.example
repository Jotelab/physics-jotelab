NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev fallback only. Production Vercel env should use your Vercel URL.
# Multi-domain OAuth redirects are resolved from request headers at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_GENERATIVE_AI_API_KEY=
VERCEL_OIDC_TOKEN=

# Symbolic engine service (jotelab-ai, DEVELOPMENT_PLAN §1.1). The web app calls this
# for all computed numbers instead of trusting the LLM. ENGINE_API_KEY must match the
# value set on the engine service and is sent as the `X-Engine-Api-Key` header.
ENGINE_BASE_URL=http://localhost:8000
ENGINE_API_KEY=

# Generation flow (DEVELOPMENT_PLAN §1.2/§1.3): "neuro_symbolic" (default) routes
# engine-backed lessons (SUVAT / motion-1d) through the symbolic engine; "llm_only"
# forces the legacy pure-LLM path for every lesson.
GENERATION_MODE=neuro_symbolic

# Background worksheet generation (Inngest). From Inngest dashboard or `npx inngest-cli dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional. Max worksheet generations running at once function-wide (default 25);
# caps concurrent model calls / DB connections under a burst.
INNGEST_GENERATION_CONCURRENCY=

# Server-only. Project JWT secret from Supabase Dashboard → Settings → API.
SUPABASE_JWT_SECRET=

# E2E tests (optional — authenticated Playwright project)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
# Set to true to skip Inngest/AI during E2E (uses fixture questions; CI sets this automatically).
E2E_STUB_GENERATION=
